<?xml version="1.0" encoding="utf-8"?>
<!--
  One package source for the repository (DCS-010). With central package management, more than one source without
  package-source mapping raises NU1507 - e.g. the "Microsoft Visual Studio Offline Packages" source that Visual Studio
  adds on Windows - which would break the zero-warning build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
