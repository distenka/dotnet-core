<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for Distenka.Client (DCS-020 onwards). No reference to the processor host (ADR-001).
       net472 is added by DCS-014 (ADR-005 §2.3) to exercise the netstandard2.0 asset. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Distenka.Client.Tests</AssemblyName>
    <RootNamespace>Distenka.Client.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Distenka.Client\Distenka.Client.csproj" />
  </ItemGroup>

</Project>
