<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform REST client (ADR-001, ADR-005 §2.2, ADR-008).
    - net8.0 + netstandard2.0 (.NET Framework 4.7.2+).
    - System.Text.Json only; the package on netstandard2.0, in-box on net8.0 (ADR-008 §2.1.2).
    - Allowed dependencies (ADR-001 §2.1): Microsoft.Extensions.Http / Options / DependencyInjection.Abstractions, plus
      Configuration.Abstractions (already in Microsoft.Extensions.Http's closure; referenced directly because IConfiguration
      is part of the public AddDistenkaClient overload).
    - Never references the processor host, Newtonsoft.Json, NJsonSchema, Spectre.Console, System.CommandLine or a SignalR
      client (ADR-008 §2.1.1; asserted by Package_boundaries in Distenka.Tests).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>Distenka.Client</AssemblyName>
    <RootNamespace>Distenka.Client</RootNamespace>
    <PackageId>Distenka.Client</PackageId>
    <Version>2.0.0-preview.1</Version>
    <Nullable>enable</Nullable>
    <Company>Distenka</Company>
    <Authors>distenka</Authors>
    <Description>Client for the Distenka platform REST API.</Description>
    <PackageProjectUrl>https://github.com/distenka/dotnet-core</PackageProjectUrl>
    <PackageTags>distenka;client;rest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Distenka.Client.Tests" />
  </ItemGroup>

</Project>
